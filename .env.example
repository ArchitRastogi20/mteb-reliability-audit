# Copy to .env and fill in the values you need.
# Each subproject loads its own .env via python-dotenv; you can keep one shared
# file at the repo root and symlink it into the subprojects, or maintain
# separate .env files inside mteb-language-gap/, rag-dataset/, etc.

# ── Hosted-LLM keys for dataset generation and judge calls ──────────────────
# Used by rag-dataset/scripts/eval_*_judge.py and the synthetic-corpus pipeline.
OPENAI_API_KEY=
CHATGPT_API_KEY=        # alias used by some scripts; usually equal to OPENAI_API_KEY

# ── LLM-judge SDK key (replace with your judge LLM provider) ────────────────
# The repository ships a stub (`judge_llm_sdk`); swap in your
# preferred SDK before running the cross-judge or open-weight propagation evals.
JUDGE_API_KEY=

# ── Embedding-API keys for closed-source comparison runs ────────────────────
# Used by rag-dataset/scripts/eval_api_embed.py and analysis/integrate_api_results.py.
COHERE_API_KEY=
GOOGLE_API_KEY=         # Gemini embedding API
VOYAGE_API_KEY=         # Optional, used only if you re-run the Voyage rows
